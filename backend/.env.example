# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/student-platform?appName=Cluster0

# Server Port
PORT=5001

# JWT Secret (for legacy tokens)
JWT_SECRET=your_jwt_secret_key_here

# OpenRouter / OpenAI API Key for AI Tutor and Quiz Generator
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Clerk Secret Key for backend token verification
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
