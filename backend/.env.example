# MongoDB connection string (get free cluster from mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/student-platform

# Server port
PORT=5000

# JWT secret for auth tokens (any random long string)
JWT_SECRET=change_this_to_a_long_random_string

# OpenAI API key (for AI Tutor + Roadmap generation)
OPENAI_API_KEY=sk-your-key-here
